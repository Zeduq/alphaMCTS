# AlphaMCTS 环境变量配置
# 复制此文件为 .env 并填入你的实际API Key

# ==================== API配置 ====================

# Qwen (阿里云 DashScope) API Key
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# OpenAI API Key (或中转平台)
# 如果使用中转平台，请同时修改 OPENAI_BASE_URL
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== 可选配置 ====================

# LLM模型选择 (qwen3-max 或 gpt-4o)
LLM_MODEL_TYPE=qwen3-max

# 提示词语言 (prompts 或 prompts_cn)
PROMPT_DIR=inference/prompts/cn

# MCTS搜索参数
INITIAL_SEARCH_BUDGET=10
EFFECTIVENESS_THRESHOLD=2

# 数据路径 (可选，默认使用项目内路径)
# DATA_DIR=D:/AAProject/Data
